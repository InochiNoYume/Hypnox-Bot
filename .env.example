# SUPABASE — server-side only. Prefer the new secret key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy key, supported during Supabase migration.
SUPABASE_SERVICE_ROLE_KEY=
# Optional JSON object used by some Supabase environments.
SUPABASE_SECRET_KEYS=

# DOTENVX — only needed when .env contains encrypted: values.
# Keep this private server-side; never commit it.
DOTENV_PRIVATE_KEY=

NODE_ENV=production
BOT_COLOR=000000
BOT_TIMEZONE=America/Santiago
OFFICIAL_DISCORD_URL=
WEBSITE_URL=
YOUTUBE_URL=
TIKTOK_URL=
INSTAGRAM_URL=
DEBUG=false
